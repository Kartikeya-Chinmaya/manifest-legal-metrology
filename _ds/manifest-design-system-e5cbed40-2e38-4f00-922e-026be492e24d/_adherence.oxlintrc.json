{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/status/**",
              "ui_kits/scanner/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Black|IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Archivo Black, IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurnHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|size|roughness|align|style|key|ref|className|style|children)$/]",
        "message": "<BurnHeading> doesn't accept that prop. Declared props: children, as, size, roughness, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurnHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|div|span)$/]",
        "message": "<BurnHeading> as must be one of 'h1' | 'h2' | 'h3' | 'div' | 'span'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurnHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xxl|xl|lg|md|sm|xs)$/]",
        "message": "<BurnHeading> size must be one of 'xxl' | 'xl' | 'lg' | 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurnHeading'] > JSXAttribute[name.name='roughness'] > Literal[value!=/^(?:normal|heavy|none)$/]",
        "message": "<BurnHeading> roughness must be one of 'normal' | 'heavy' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BurnHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<BurnHeading> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|block|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, block, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|danger|verify|review|plate|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'danger' | 'verify' | 'review' | 'plate' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
